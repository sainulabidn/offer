---
// A category across the UAE (near the shopper, once they set a place); /dubai/c/… is the same in one emirate.
import ListingPage from '../../components/ListingPage.astro';
import { api, findCategory } from '../../lib/api';
import { cacheFor } from '../../lib/format';

const categories = await api.categories();
const category = findCategory(categories, Astro.params.slug ?? '');
if (!category) return Astro.rewrite('/404');

cacheFor(Astro.response.headers);
---

<ListingPage category={category} categories={categories} />
