---
import Base from '../../layouts/Base.astro';
import SearchResults from '../../components/SearchResults.astro';
import { api, findCategory } from '../../lib/api';
import { cacheFor } from '../../lib/format';

const category = findCategory(await api.categories(), Astro.params.slug ?? '');
if (!category) return Astro.rewrite('/404');

cacheFor(Astro.response.headers);
---

<Base title={`${category.name} offers in the UAE · offer`} description={`This week's ${category.name.toLowerCase()} deals from UAE supermarkets, compared by unit price.`}>
  {category.children.length > 0 && (
    <nav class="rail mb-2" aria-label="Subcategories">
      {category.children.map((child) => (
        <a href={`/c/${child.slug}`} class="chip">{child.name}</a>
      ))}
    </nav>
  )}
  <SearchResults title={category.name} baseFilters={[`category_ids:=${category.id}`]} />
</Base>
