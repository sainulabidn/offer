---
import ProductPage from '../../components/ProductPage.astro';
import { api } from '../../lib/api';
import { cacheFor, productPath } from '../../lib/format';

const product = await api.product(Astro.params.slug ?? '');
if (!product) return Astro.rewrite('/404');

// Old links (?variant=2-l) move to the pack's own page; with one pack, the product page is it.
const wanted = Astro.url.searchParams.get('variant');
if (wanted !== null) {
  const pack = product.variants.find((v) => v.slug === wanted);
  return Astro.redirect(productPath(product.slug, pack && product.variants.length > 1 ? pack.slug : null), 301);
}

cacheFor(Astro.response.headers);
---

<ProductPage product={product} variant={null} />
