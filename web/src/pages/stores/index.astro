---
import { distanceKm } from '@offer/rank';
import Base from '../../layouts/Base.astro';
import StoresExplorer from '../../islands/StoresExplorer';
import { directory, placeOf, storeCards } from '../../lib/near';
import { cacheFor } from '../../lib/format';

const dir = await directory();
const place = placeOf(dir, Astro.locals.prefs);
const here = place.rough ? null : place.at;

const stores = storeCards(dir)
  .map((store) => ({ ...store, km: here ? distanceKm(here, store) : null }))
  .sort((a, b) => (a.km ?? 0) - (b.km ?? 0) || a.grade - b.grade || a.chain.localeCompare(b.chain));

cacheFor(Astro.response.headers);
---

<Base title="Stores near you · offer" description="Every supermarket on offer, with this week's deals at each branch.">
  <h1 class="text-2xl font-bold">Stores{here && place.name ? ` near ${place.name}` : ''}</h1>
  <p class="mt-1 mb-4 text-sm text-muted">{stores.length} stores{here ? ', nearest first' : ''}. Tick up to 4 to compare their prices.</p>

  <StoresExplorer client:load stores={stores} />
</Base>
