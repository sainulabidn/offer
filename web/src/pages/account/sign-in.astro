---
import Base from '../../layouts/Base.astro';
import SignInForm from '../../islands/SignInForm';

const next = Astro.url.searchParams.get('next') ?? '/';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Base title="Sign in · offer">
  <div class="mx-auto max-w-sm rounded-2xl border border-zinc-200 bg-white p-6 shadow-xs">
    <h1 class="mb-1 text-xl font-bold">Sign in</h1>
    <p class="mb-5 text-sm text-zinc-500">Like deals and get alerts. No password needed.</p>
    <SignInForm client:load next={next} />
  </div>
</Base>
