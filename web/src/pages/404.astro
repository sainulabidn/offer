---
import { ArrowRight } from 'lucide-react';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · offer">
  <div class="mx-auto max-w-md py-12 text-center">
    <p aria-hidden="true" class="text-6xl">🧺</p>
    <h1 class="mt-4 text-2xl font-bold">We couldn't find that page</h1>
    <p class="mt-2 text-muted">The offer may have ended, or the link may be old. This week's deals are a tap away.</p>
    <a href="/" class="btn btn-primary mt-5">See this week's deals <ArrowRight class="size-4" aria-hidden="true" /></a>
  </div>
</Base>
