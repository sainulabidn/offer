---
import { ArrowRight, LocateFixed, Square, SquareCheck, X } from 'lucide-react';
import Base from '../layouts/Base.astro';
import CategoryNav from '../components/CategoryNav.astro';
import CompareTable from '../components/CompareTable.astro';
import OfferGrid from '../components/OfferGrid.astro';
import StoreFocus from '../components/StoreFocus.astro';
import { api } from '../lib/api';
import ForYouRail from '../islands/ForYouRail';
import NearbyStores from '../islands/NearbyStores';
import { cheapestNearby, comparePrices } from '../lib/feed';
import { itemFilters, itemRadius, nearestBranches, placeOf, regionId, staffFilters, storeCards, storeRadius, storeTile, storesFor, directory } from '../lib/near';
import { cacheFor } from '../lib/format';
import { searchOffers } from '../lib/search';
import { seoData } from '../lib/seo';

const prefs = Astro.locals.prefs;
const dir = await directory();
const place = placeOf(dir, prefs);
// An emirate guessed from the network is too rough for distances or a radius.
const exact = Boolean(place.at && !place.rough);
const radius = storeRadius(dir, prefs);
const itemKm = itemRadius(dir, prefs);
const stores = storesFor(dir, prefs);
// A saved id can outlive its store; the page then treats it as not selected.
const selected = storeCards(dir).filter((store) => prefs.stores.includes(store.id));

const [categories, cheapest, ending, trendingIds] = await Promise.all([
  api.categories(),
  cheapestNearby(dir, prefs, { perPage: 20 }),
  searchOffers({ sort: 'ending', perPage: 5, filters: staffFilters(prefs) }),
  api.trending(regionId(dir, prefs) ?? null),
]);
// Needs a real rise in the area; a rail of one or two looks broken.
const trending = trendingIds.length >= 4 ? await cheapestNearby(dir, prefs, { perPage: 5, filters: [`product_id:[${trendingIds.join(',')}]`] }) : null;
const compare = await comparePrices(cheapest.hits, dir, prefs);
const distances = exact ? nearestBranches(dir, place.at, itemKm) : undefined;
const topSaving = Math.max(0, ...cheapest.hits.map((hit) => Math.round(hit.discount_pct ?? 0)));
const { settings } = await seoData();

cacheFor(Astro.response.headers);
---

<Base title={`${settings.site_name} · ${settings.tagline}`} fullTitle region={regionId(dir, prefs)}>
  <h1 class="sr-only">{settings.site_name}: {settings.tagline}</h1>
  {exact ? (
    <p class="mb-4 text-sm text-muted">
      <strong class="font-semibold text-ink">{cheapest.found} products on offer</strong> near {place.name}
    </p>
  ) : (
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
      <p class="text-sm text-muted">
        <strong class="font-semibold text-ink">{cheapest.found} products on offer</strong> {place.name ? `in ${place.name}` : 'across the UAE'}{topSaving > 0 && `, up to ${topSaving}% off`}
      </p>
      {/* data-ask-location: without a location, the location sheet opens by itself (LocationSheet); this button brings it back after a close. */}
      <button type="button" data-open-location data-ask-location class="chip">
        <LocateFixed class="size-4" aria-hidden="true" /> Set your location
      </button>
    </div>
  )}

  <CategoryNav categories={categories} />

  <NearbyStores
    client:idle
    stores={stores.map(storeTile)}
    title={exact ? `Stores near ${place.name ?? 'you'}` : place.rough ? `Stores in ${place.name}` : 'Stores'}
    at={exact ? place.at : null}
    radiusKm={radius}
    radiusOptions={dir.settings.radius_options}
    radiusMax={dir.settings.radius_max}
    selected={prefs.stores}
  />

  <ForYouRail client:only="react" filters={itemFilters(dir, prefs)} />

  {selected.length > 0 && (
    <section class="mt-5" aria-labelledby="selected-title">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <h2 id="selected-title" class="text-xl font-bold">{selected.length === 1 ? `Prices at ${selected[0].chain}, ${selected[0].name}` : `Comparing ${selected.length} stores`}</h2>
        <a href="/?stores=" rel="nofollow" class="chip">Clear <X class="size-4" aria-hidden="true" /></a>
      </div>
      {selected.length === 1 ? <StoreFocus dir={dir} store={selected[0]} /> : <CompareTable dir={dir} stores={selected} />}
    </section>
  )}

  <section class:list={['mt-5', selected.length > 0 && 'hidden']} aria-labelledby="cheapest-title">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 id="cheapest-title" class="text-xl font-bold">{itemKm ? 'Cheapest near you' : 'Cheapest in the UAE'}</h2>
      <div class="flex flex-wrap gap-2">
        {itemKm ? (
          <a href="/?items=all" rel="nofollow" class="chip chip-on" aria-label={`Within ${itemKm} km. Remove this limit`}>
            Within {itemKm} km <X class="size-4" aria-hidden="true" />
          </a>
        ) : place.at && (
          <a href={`/?items=${dir.settings.item_radius_default}`} rel="nofollow" class="chip">Limit to {dir.settings.item_radius_default} km</a>
        )}
        <a href={`/?staff=${prefs.hideStaffOnly ? 1 : 0}`} rel="nofollow" role="checkbox" aria-checked={prefs.hideStaffOnly ? 'false' : 'true'} class:list={['chip', !prefs.hideStaffOnly && 'chip-on']}>
          {prefs.hideStaffOnly ? <Square class="size-4" aria-hidden="true" /> : <SquareCheck class="size-4" aria-hidden="true" />} Include registered-customer offers
        </a>
      </div>
    </div>
    <OfferGrid offers={cheapest.hits} distances={distances} compare={compare} empty={itemKm ? `No offers within ${itemKm} km. Remove the distance limit to see all of the UAE.` : undefined} />
    <div class="mt-4 text-center">
      <a href="/search?sort=rank" class="btn btn-quiet">See all offers <ArrowRight class="size-4" aria-hidden="true" /></a>
    </div>
  </section>

  {trending && trending.hits.length >= 4 && (
    <section class="mt-8" aria-labelledby="trending-title">
      <h2 id="trending-title" class="mb-3 text-xl font-bold">Trending near you</h2>
      <OfferGrid offers={trending.hits} distances={distances} />
    </section>
  )}

  {ending.hits.length > 0 && (
    <section class="mt-8" aria-labelledby="ending-title">
      <div class="mb-3 flex items-baseline justify-between">
        <h2 id="ending-title" class="text-xl font-bold">Ending soon</h2>
        <a href="/search?sort=ending" class="link text-sm">See all</a>
      </div>
      <OfferGrid offers={ending.hits} />
    </section>
  )}
</Base>
