---
// One store's offer, shown like an online-shop product card. Plain HTML; the like button hydrates,
// and "add to plan" is handled by one listener for the whole page (lib/quick-add.ts).
import { Clock, Plus } from 'lucide-react';
import LikeButton from '../islands/LikeButton';
import Price from './Price.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import StoreLogo from './StoreLogo.astro';
import type { ComparePrice, NearbyPrice } from '../lib/feed';
import type { OfferHit } from '../lib/search';
import { aed, distanceLabel, endsIn, offerTargets, shortDate, timeLeft, tintFor } from '../lib/format';

interface Props {
  offer: OfferHit;
  nearest?: { km: number; branch: string };
  /** Other stores' prices for the same pack. */
  compare?: ComparePrice[];
  /** With one store selected: the nearest other store's price for the same pack. */
  nearby?: NearbyPrice;
}

const { offer, nearest, compare = [], nearby } = Astro.props;
const href = `/products/${offer.product_slug}?variant=${encodeURIComponent(offer.variant_slug)}`;
const saving = offer.regular_price && offer.regular_price > offer.price ? offer.regular_price - offer.price : 0;
// A whole-group card ("Tomato") names the group, with the variety that is cheapest underneath.
const isGroup = offer.compare_key?.startsWith('g') ?? false;
const title = isGroup ? offer.product_group : offer.product_name;
const detail = isGroup && offer.product_name.toLowerCase() !== offer.product_group.toLowerCase() ? `${offer.product_name} · ${offer.variant_label}` : offer.variant_label;
const options = offer.group_found ?? 1;
---

<article class="card relative flex flex-col overflow-hidden transition hover:shadow-float">
  <div class:list={['relative grid aspect-[3/2] place-items-center overflow-hidden', offer.image ? 'photo' : tintFor(offer.product_group)]}>
    {offer.image ? (
      <ResponsiveImage base={offer.image} alt="" sizes="(min-width: 1280px) 15vw, (min-width: 1024px) 20vw, (min-width: 640px) 30vw, 45vw" class="size-full object-contain p-2" />
    ) : (
      <span aria-hidden="true" class="text-[3.25rem] leading-none drop-shadow-sm">{offer.icon ?? offer.product_name.charAt(0)}</span>
    )}
    {offer.discount_pct && offer.discount_pct >= 1 && (
      <span class="badge badge-save absolute start-2 top-2">-{Math.round(offer.discount_pct)}%</span>
    )}
    <div class="absolute end-2 top-2 z-10">
      <LikeButton client:visible target={`offer:${offer.id}`} activity={offerTargets(offer)} />
    </div>
  </div>

  <div class="flex flex-1 flex-col p-3">
    <p class="mb-1 flex min-w-0 items-center gap-1.5 text-xs font-medium text-muted">
      <StoreLogo name={offer.chain_name} class="size-5 text-[0.5rem]" />
      <span class="min-w-0 truncate">{offer.chain_name}</span>
      {nearest && <span class="ms-auto shrink-0">{distanceLabel(nearest.km)}</span>}
    </p>
    <h3 class="line-clamp-2 text-sm/snug font-semibold">
      <a href={href} data-click={`product:${offer.product_id} chain:${offer.chain_id}`} class="after:absolute after:inset-0">{title}</a>
    </h3>
    <p class="mt-0.5 text-xs text-muted">{detail}</p>
    {options > 1 && (
      isGroup ? (
        <a href={`/search?group=${offer.product_group_id}&sort=unit`} class="relative z-10 mt-0.5 self-start text-xs font-semibold text-link hover:underline">Cheapest of {options} offers</a>
      ) : (
        <p class="mt-0.5 text-xs font-medium text-muted">Cheapest of {options} offers</p>
      )
    )}

    <div class="mt-auto pt-2">
      <div class="flex items-end justify-between gap-2">
        <div class="min-w-0">
          <p class="flex flex-wrap items-baseline gap-x-1.5">
            <Price value={offer.price} class="text-[1.375rem] leading-tight" />
            {saving > 0 && <s class="text-xs text-muted">{offer.regular_price?.toFixed(2)}</s>}
          </p>
          {offer.effective_unit_price && <p class="text-xs text-muted tabular-nums">{aed(offer.effective_unit_price)} {offer.unit_label}</p>}
        </div>
        <button
          type="button"
          data-add-plan
          data-variant={offer.variant_id}
          data-targets={offerTargets(offer)}
          data-label={`${offer.product_name} · ${offer.variant_label}`}
          aria-label={`Add ${offer.product_name} to my plan`}
          class="relative z-10 -mb-0.5 grid size-10 shrink-0 place-items-center rounded-full bg-primary text-on-primary transition hover:bg-primary-strong active:scale-95"
        >
          <Plus class="size-5" aria-hidden="true" />
        </button>
      </div>

      {offer.promo_label && <p class="mt-1 text-xs font-semibold text-save">{offer.promo_label}</p>}
      {offer.card_required && <p class="mt-1 text-xs font-medium text-muted">With loyalty card</p>}
      {offer.staff_only && <p class="mt-1 text-xs font-medium text-warn">Store employees only</p>}
      {offer.condition_label && <p class="mt-1 text-xs font-medium text-muted">{offer.condition_label}</p>}
      {offer.is_lowest_90d && <p class="mt-1 text-xs font-semibold text-link">Lowest in 90 days</p>}
      {offer.under_review && <p class="mt-1 text-xs font-medium text-warn">Being checked: shoppers reported this price</p>}

      {compare.length > 0 && (
        <ul class="mt-2 space-y-0.5 border-t border-line/70 pt-2 text-xs text-muted">
          {compare.map((other) => (
            <li class="flex items-baseline justify-between gap-2">
              <span class="truncate">{other.chain}{other.card && ' (card)'}</span>
              <span class="shrink-0 font-semibold tabular-nums">
                {other.usualOn && <span class="font-normal">usual {shortDate(other.usualOn)} · </span>}{other.price.toFixed(2)}
              </span>
            </li>
          ))}
        </ul>
      )}
      {nearby && (
        <div class="mt-2 border-t border-line/70 pt-2 text-xs text-muted">
          <p class="flex items-baseline justify-between gap-2">
            <span class="truncate">{nearby.chain}</span>
            <span class="shrink-0 font-semibold tabular-nums">{nearby.price.toFixed(2)}</span>
          </p>
          <p>{nearby.far}{nearby.usualOn && ` · usual, ${shortDate(nearby.usualOn)}`}</p>
          {nearby.cheaperBy > 0 && !nearby.usualOn && <p class="mt-0.5 font-semibold text-save">{aed(nearby.cheaperBy)} cheaper there</p>}
        </div>
      )}
    </div>

    {offer.time_window && offer.window_ends_at && (
      <p data-timed class="mt-2 flex flex-wrap items-center gap-x-1.5 text-xs font-semibold text-warn">
        <Clock class="size-3.5 shrink-0" aria-hidden="true" />
        <span>{offer.time_window}</span>
        <span class="tabular-nums" data-ends-at={offer.window_ends_at} aria-live="off">{timeLeft(offer.window_ends_at)}</span>
      </p>
    )}
    <p class:list={[offer.time_window ? 'mt-0.5' : 'mt-2', 'text-xs text-muted']}>{endsIn(offer.valid_to)}</p>
  </div>
</article>
