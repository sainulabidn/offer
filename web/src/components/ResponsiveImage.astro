---
// Product photo: a white 350 px square (and a 160 px copy) that the .photo tile blends into its gradient.
// `base` comes from the API/search index; files are "{base}-{160|350}.webp" (see backend GenerateImageSizes).
interface Props {
  base: string;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { base, alt, sizes, priority = false, class: className } = Astro.props;
---

<img
  src={`${base}-350.webp`}
  srcset={`${base}-160.webp 160w, ${base}-350.webp 350w`}
  sizes={sizes}
  alt={alt}
  width={350}
  height={350}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding="async"
  class={className}
/>
