---
// Every list of offers (search, category, brand, location, landing pages): filter sidebar (a plain GET form,
// works without JavaScript), sort and results. The search itself is run by the page (lib/listing.ts).
import { SlidersHorizontal } from 'lucide-react';
import OfferGrid from './OfferGrid.astro';
import Pagination from './Pagination.astro';
import { SORTS } from '../lib/search';
import type { Listing } from '../lib/listing';

interface Props {
  title: string;
  listing: Listing;
  /** Staff-written text under the heading (SEO pages). */
  intro?: string;
  /** On a location page ("/dubai"): cards open the product's prices there. */
  placePath?: string;
}

const { title, listing, intro, placePath } = Astro.props;
const params = Astro.url.searchParams;
const { q, sort, chains, brands, cardOnly, minDiscount, groupId, hideStaffOnly, activeFilters, place, radiusKm, nearby, result } = listing;
// The sidebar lists the 20 biggest; browse links may have asked for more.
const facet = (field: string) => listing.facet(field).slice(0, 20);
// A landing page's own search words stay in its URL, not in a hidden field.
const ownQ = params.get('q');
---

<h1 class="mb-1 text-2xl font-bold">{groupId && result.hits[0] ? `All ${result.hits[0].product_group.toLowerCase()} offers` : title}</h1>
<p class="mb-4 text-sm text-muted">
  {result.found} {result.found === 1 ? 'offer' : 'offers'}{radiusKm && place.name && ` within ${radiusKm} km of ${place.name}`}
</p>
{intro && <p class="mb-4 max-w-3xl text-sm/relaxed text-muted">{intro}</p>}
<slot name="top" />

<button type="button" id="filters-open" class="btn btn-quiet mb-4 lg:hidden">
  <SlidersHorizontal class="size-4" aria-hidden="true" /> Filters{activeFilters > 0 && ` (${activeFilters})`}
</button>

<div class="grid gap-6 lg:grid-cols-[14rem_1fr]">
  <dialog id="filters" class="sheet filters" aria-label="Filters">
    <form method="get" class="space-y-5 p-5 text-sm lg:p-0">
      {ownQ && <input type="hidden" name="q" value={q} />}
      {['near', 'r', 'items', 'group'].map((k) => params.get(k) && <input type="hidden" name={k} value={params.get(k)!} />)}
      <label class="block">
        <span class="font-semibold">Sort</span>
        <select name="sort" class="input mt-2">
          {Object.entries(SORTS).map(([key, option]) => <option value={key} selected={key === sort}>{option.label}</option>)}
        </select>
      </label>
      {facet('chain_name').length > 0 && (
        <fieldset>
          <legend class="font-semibold">Store</legend>
          {facet('chain_name').map((v) => (
            <label class="flex min-h-9 items-center gap-2">
              <input type="checkbox" name="store" value={v.value} checked={chains.includes(v.value)} class="size-4 accent-[var(--color-primary)]" />
              {v.value} <span class="text-muted">({v.count})</span>
            </label>
          ))}
        </fieldset>
      )}
      {facet('brand').length > 0 && (
        <fieldset>
          <legend class="font-semibold">Brand</legend>
          {facet('brand').map((v) => (
            <label class="flex min-h-9 items-center gap-2">
              <input type="checkbox" name="brand" value={v.value} checked={brands.includes(v.value)} class="size-4 accent-[var(--color-primary)]" />
              {v.value} <span class="text-muted">({v.count})</span>
            </label>
          ))}
        </fieldset>
      )}
      <label class="block">
        <span class="font-semibold">Discount</span>
        <select name="min_discount" class="input mt-2">
          {[0, 10, 20, 30, 50].map((d) => <option value={d} selected={d === minDiscount}>{d ? `${d}% or more` : 'Any'}</option>)}
        </select>
      </label>
      <label class="flex min-h-9 items-center gap-2"><input type="checkbox" name="card" value="1" checked={cardOnly} class="size-4 accent-[var(--color-primary)]" /> Loyalty card prices only</label>
      {/* An unticked box sends nothing, so the hidden 0 goes first and a tick's 1 overrides it (resolvePrefs). */}
      <input type="hidden" name="staff" value="0" />
      <label class="flex min-h-9 items-center gap-2"><input type="checkbox" name="staff" value="1" checked={!hideStaffOnly} class="size-4 accent-[var(--color-primary)]" /> Include registered-customer offers</label>
      <button class="btn btn-primary w-full">Apply filters</button>
      <button type="button" id="filters-close" class="btn btn-quiet w-full lg:hidden">Close</button>
    </form>
  </dialog>

  <div class="min-w-0">
    <OfferGrid offers={result.hits} distances={nearby} place={placePath} empty={radiusKm ? `No offers within ${radiusKm} km. Try a bigger radius.` : 'No offers match these filters.'} />
    <Pagination page={result.page} pages={result.pages} />
  </div>
</div>

<noscript><style>.filters { display: block; position: static; transform: none; opacity: 1; }</style></noscript>

<script>
  const filters = document.querySelector<HTMLDialogElement>('#filters');
  document.querySelector('#filters-open')?.addEventListener('click', () => filters?.showModal());
  document.querySelector('#filters-close')?.addEventListener('click', () => filters?.close());
</script>
