---
import '../styles/global.css';
import { ChevronDown, ClipboardList, House, MapPin, Store, UserRound } from 'lucide-react';
import fontUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import Logo from '../components/Logo.astro';
import LocationSheet from '../islands/LocationSheet';
import SearchBox from '../islands/SearchBox';
import WelcomeBar from '../islands/WelcomeBar';

interface Props {
  title: string;
  description?: string;
  /** The shopper's area, for counts by area ("trending near you"). */
  region?: number | null;
}

const { title, description = 'Compare supermarket offers across the UAE by true unit price.', region } = Astro.props;
const q = Astro.url.searchParams.get('q') ?? '';
const path = Astro.url.pathname;

const tabs = [
  { href: '/', label: 'Home', Icon: House, active: path === '/' },
  { href: '/stores', label: 'Stores', Icon: Store, active: path.startsWith('/stores') },
  { href: '/plan', label: 'My plan', Icon: ClipboardList, active: path.startsWith('/plan') },
  { href: '/account', label: 'Account', Icon: UserRound, active: path.startsWith('/account') },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF7F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D1512" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh" data-region={region ?? undefined}>
    <header class="app-bar sticky top-0 z-30 border-b border-line/70 bg-canvas/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-3 gap-y-2.5 px-4 py-2.5 md:flex-nowrap md:gap-x-5 md:py-3">
        <a href="/" aria-label="offer home" class="rounded-lg"><Logo /></a>
        <button type="button" data-open-location class="ms-auto flex min-h-10 max-w-[60vw] min-w-0 items-center gap-1.5 rounded-full border border-line bg-surface ps-2.5 pe-2 text-sm font-semibold shadow-card md:ms-0 md:max-w-56">
          <MapPin class="size-4 shrink-0 text-primary" aria-hidden="true" />
          <span class="sr-only">Change location:</span>
          <span id="location-label" class="truncate">Set your area</span>
          <ChevronDown class="size-4 shrink-0 text-muted" aria-hidden="true" />
        </button>
        <div class="w-full md:flex-1">
          <!-- Server-rendered as a plain search form; suggestions start once the page is idle. -->
          <SearchBox client:idle initial={q} />
        </div>
        <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
          {tabs.slice(1).map(({ href, label, active }) => (
            <a href={href} aria-current={active ? 'page' : undefined} class:list={['rounded-full px-3.5 py-2 text-sm font-semibold transition hover:bg-sunken', active ? 'text-link' : 'text-ink']}>
              {label}{href === '/plan' && <span data-plan-count class="ms-1.5 hidden rounded-full bg-save-fill px-1.5 py-px text-xs text-on-save" />}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <script is:inline>
      // Drawn here, not on the server: the label is the shopper's own ("Home"), and this page is cached for everyone.
      try {
        var saved = document.cookie.match(/(?:^|;\s*)offer_prefs=([^;]*)/);
        var label = saved && new URLSearchParams(decodeURIComponent(saved[1])).get('l');
        if (label) document.getElementById('location-label').textContent = label;
      } catch (e) {}
    </script>

    <main class="mx-auto max-w-7xl px-4 pt-4 pb-28 md:pt-6 md:pb-12">
      <slot />
    </main>

    <footer class="mx-auto mb-20 max-w-7xl border-t border-line/70 px-4 py-6 text-center text-xs text-muted md:mb-0">
      Prices as published in store brochures; please confirm in store.
    </footer>

    <nav aria-label="Main" class="tab-bar fixed inset-x-0 bottom-0 z-30 border-t border-line/70 bg-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden">
      <ul class="mx-auto grid h-16 max-w-md grid-cols-4">
        {tabs.map(({ href, label, Icon, active }) => (
          <li>
            <a href={href} aria-current={active ? 'page' : undefined} class:list={['relative flex h-full flex-col items-center justify-center gap-0.5 text-[0.6875rem] font-semibold', active ? 'text-link' : 'text-muted']}>
              <span class:list={['grid h-7 w-12 place-items-center rounded-full transition', active && 'bg-primary-soft']}><Icon class="size-5" aria-hidden="true" /></span>
              {label}
              {href === '/plan' && <span data-plan-count class="absolute top-1.5 start-1/2 ms-2 hidden min-w-4 rounded-full bg-save-fill px-1 text-center text-[0.625rem] leading-4 text-on-save" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div id="toast" role="status" aria-live="polite" class="pointer-events-none fixed inset-x-0 bottom-24 z-40 flex justify-center px-4 md:bottom-8"></div>

    <LocationSheet client:load />
    <WelcomeBar client:idle />

    <script>
      import { startCounting } from '../lib/track';
      import { startPlanBadge } from '../lib/quick-add';

      startCounting();
      startPlanBadge();
    </script>
  </body>
</html>
