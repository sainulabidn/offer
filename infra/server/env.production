# Template for ~/offer/backend/.env on offer.emirait.com. after-deploy.sh fills APP_KEY, the database
# lines (from ~/.offer-db.env) and the Typesense keys the first time. Never commit the real .env.
APP_NAME=offer
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://offer.emirait.com
APP_MARKET_TIMEZONE=Asia/Dubai
FRONTEND_URL=https://offer.emirait.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database lines are appended from ~/.offer-db.env

# No Redis password on this account: cache, sessions and queue use PostgreSQL.
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_DOMAIN=offer.emirait.com
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
QUEUE_CRON_WORKER=true
SANCTUM_STATEFUL_DOMAINS=offer.emirait.com

MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="noreply@offer.emirait.com"
MAIL_FROM_NAME="${APP_NAME}"

SCOUT_DRIVER=typesense
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_KEY=
# Typesense listens on localhost; browsers and the Worker search through Laravel at /typesense.
TYPESENSE_PROXY=true
TYPESENSE_PUBLIC_URL=https://offer.emirait.com/typesense

# Product images: "public" (on this server) until the R2 keys below are filled in, then "r2".
MEDIA_DISK=public
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=offer
R2_PUBLIC_URL=

TURNSTILE_SECRET=
